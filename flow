const highlightText = (text, keywords) => {
  let elements = [];
  let currentText = text;

  keywords.forEach((keyword, idx) => {
    if (!currentText.includes(keyword)) return;
    const parts = currentText.split(keyword);
    if (parts.length > 1) {
      elements.push(parts[0]);
      elements.push(
        <strong key={idx} className="text-[#00428B] font-bold">
          {keyword}
        </strong>
      );
      currentText = parts.slice(1).join(keyword);
    }
  });
  elements.push(currentText);
  return elements.length > 0 ? elements : text;
};

